{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "alwaysStrict": true,

    /* Type checking */
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Paths
     *
     * Only the `three` type mappings live here. The eight `@…/*` source aliases
     * (`@/*`, `@components/*`, `@utils/*`, `@services/*`, `@hooks/*`, `@types/*`,
     * `@config/*`, `@store/*`) were deleted 2026-08-27: `vite.config.js` has no
     * matching `resolve.alias`, so an aliased import would typecheck here and
     * then fail to bundle. Do not re-add an alias to this list without adding
     * the matching Vite alias in the same change — every import in the codebase
     * is relative, so there is nothing to migrate.
     */
    "baseUrl": "./src",
    "paths": {
      "three": ["../node_modules/@types/three"],
      "three/*": ["../node_modules/@types/three/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "build", "src/**/__tests__/**", "src/**/*.test.*", "src/**/*.spec.*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}