# Supabase Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: For enhanced security in production
# VITE_APP_URL=https://your-app-domain.com
# VITE_ENABLE_ANALYTICS=false

# Gemini API key for Vessel Modeler drawing import: server-side ONLY.
# Set GEMINI_API_KEY as a Supabase secret for the `gemini-proxy` edge function.
# Never a VITE_-prefixed variable — Vite inlines those into the client bundle,
# which would publish the key to every visitor.

# PII Lockdown: set to 'true' to enable maintenance mode (tools only, no data pages)
# VITE_MAINTENANCE_MODE=false
